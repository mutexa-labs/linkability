{
  "name": "@mutexa/linkability",
  "version": "0.1.0",
  "description": "A written spec for how easily position slices can be clustered, the scorer, golden vectors, and a verifier that scores real Hyperliquid accounts from public data.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutexa-labs/linkability.git"
  },
  "homepage": "https://github.com/mutexa-labs/linkability#readme",
  "bugs": {
    "url": "https://github.com/mutexa-labs/linkability/issues"
  },
  "keywords": [
    "privacy",
    "linkability",
    "clustering",
    "hyperliquid",
    "on-chain-analysis",
    "perps",
    "mutexa"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "linkability": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify-entry.d.ts",
      "import": "./dist/verify-entry.js"
    },
    "./vectors/*": "./vectors/*"
  },
  "files": [
    "dist",
    "vectors",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"{src,test,scripts}/**/*.ts\"",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\"",
    "test": "vitest run",
    "record": "node scripts/record-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
